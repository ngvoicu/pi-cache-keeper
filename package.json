{
  "name": "pi-cache-keeper",
  "version": "0.10.9",
  "description": "Keeps pi's prompt cache paying off: compaction from the warm cache, a model you pick when the cache can't be used, compacting when the context is full, keeping the cache warm while idle, model windows and cache lifetimes from providers.dev. Based on pi-cached-compaction by Nico Bailon",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "compaction",
    "prompt-cache"
  ],
  "author": "Gabriel Voicu <office@providers.dev>",
  "contributors": [
    "Nico Bailon (original pi-cached-compaction, https://github.com/nicobailon/pi-cached-compaction)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ngvoicu/pi-cache-keeper#readme",
  "bugs": {
    "url": "https://github.com/ngvoicu/pi-cache-keeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvoicu/pi-cache-keeper.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.6.0",
    "@earendil-works/pi-ai": ">=1.6.0",
    "@earendil-works/pi-coding-agent": ">=1.6.0",
    "@earendil-works/pi-tui": ">=1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
